# Names only. Copy to .env on each data/witness VM and fill in. Never commit .env.
# Same on all three machines unless marked per-node.

# --- per node ---
NODE_NAME=ha-data-1          # ha-data-1 | ha-data-2 | ha-witness (etcd member names)
NODE_IP=                     # this machine's private-link address
REDIS_ROLE=primary           # primary on ha-data-1, replica on ha-data-2 (data VMs only)
MINIO_ROOT_USER=             # different on each data VM
MINIO_ROOT_PASSWORD=         # different on each data VM

# --- same everywhere ---
DATA1_IP=
DATA2_IP=
WITNESS_IP=
PRIVATE_CIDR=                # e.g. 10.20.0.0/24
CERT_DIR=../certs/out

# Generate each with: openssl rand -hex 24
PG_SUPERUSER_PASSWORD=
PG_REPLICATION_PASSWORD=
PG_REWIND_PASSWORD=
PATRONI_REST_PASSWORD=
REDIS_PASSWORD=
APP_DB_USER=enzo
APP_DB_PASSWORD=
APP_DB_NAME=enzo
