# Enzo Interiors — DEV environment (dev.enzointeriors.co.uk), docker-compose.dev.yml.
# Kept apart from .env / .env.example, which are production and plain local use.
# Real values live in Coolify (project Enzo Interiors > environment development);
# copy to .env.dev only to run this stack by hand. Never commit the filled-in copy.
# Every port, router name and image tag differs from production and pre-prod.

# ---- Database (separate Coolify PostgreSQL, never production's) --------------
POSTGRES_USER=enzo_dev
POSTGRES_DB=enzo_dev
# openssl rand -base64 24
POSTGRES_PASSWORD=
# Coolify's internal URL of the dev PostgreSQL. Empty = the bundled `db` profile.
DATABASE_URL=
COMPOSE_PROFILES=

# ---- Auth ----------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=
# At least 12 characters.  openssl rand -base64 18
ADMIN_PASSWORD=
ADMIN_NAME=Dev Admin
# Dev-only. Leave empty so staff sign-in keeps its second step (codes are in the
# API log until SMTP_HOST is set). Never copy this switch to production.
DISABLE_2FA=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ---- Publishing ------------------------------------------------------------------
# openssl rand -base64 32
REVALIDATE_SECRET=
CONTENT_REVALIDATE_SECONDS=60

# ---- Object storage (its own MinIO and buckets) ---------------------------------
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=enzo-dev-public
S3_PRIVATE_BUCKET=enzo-dev-private
# Include the bucket name.
MEDIA_BASE_URL=https://media.dev.enzointeriors.co.uk/enzo-dev-public

# ---- Hostnames (Traefik routers; Cloudflare Tunnel points each at the host) ------
DEV_WEB_HOST=www.dev.enzointeriors.co.uk
DEV_API_HOST=api.dev.enzointeriors.co.uk
DEV_ADMIN_HOST=admin.dev.enzointeriors.co.uk
DEV_PORTAL_HOST=portal.dev.enzointeriors.co.uk
DEV_MEDIA_HOST=media.dev.enzointeriors.co.uk

# ---- Public addresses (the admin and portal images are built against these) ------
WEB_PUBLIC_URL=https://www.dev.enzointeriors.co.uk
API_PUBLIC_URL=https://api.dev.enzointeriors.co.uk
ADMIN_URL=https://admin.dev.enzointeriors.co.uk
PORTAL_URL=https://portal.dev.enzointeriors.co.uk
TRUST_PROXY=2
TRUST_CLOUDFLARE=true
GOOGLE_SITE_VERIFICATION=

# ---- Email: added by hand, nothing is sent while SMTP_HOST is empty ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Enzo Interiors DEV <no-reply@dev.enzointeriors.co.uk>
ALERT_FROM=
ALERT_TO=
# openssl rand -base64 32 (same for api and web)
ALERT_SHARED_SECRET=

# ---- Google: added by hand; empty = no Google UI. Register these redirect URIs. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=https://api.dev.enzointeriors.co.uk/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://api.dev.enzointeriors.co.uk/calendar/callback
GOOGLE_GMAIL_REDIRECT_URI=https://api.dev.enzointeriors.co.uk/mailbox/callback

# ---- Web Push (npm run push:keys in apps/api; its own pair, not production's) -----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@enzointeriors.co.uk

# ---- Host ports: prod default + 20000 (compose defaults, listed so Coolify shows them) ----
WEB_PORT=23000
API_PORT=24000
ADMIN_PORT=25174
PORTAL_PORT=25175
POSTGRES_PORT=25432
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001
REDIS_PORT=26379
MAILPIT_PORT=28025
MAILPIT_SMTP_PORT=21025
