# HA pre-prod, one app VM. Names only: set the real values in Coolify (or a
# VM-only .env), never in git or chat. See docs/ha-preprod-plan.md.
# Same on BOTH app VMs unless marked per-node.

# --- per node ---
COMPOSE_PROFILES=            # "seed" on ha-app-1 only; empty on ha-app-2
LOCAL_DATA_IP=               # this node's data VM (private link)
REMOTE_DATA_IP=              # the other node's data VM

# --- data side (must match infra/ha/data/.env) ---
DATA1_IP=
DATA2_IP=
REDIS_PASSWORD=
APP_DB_USER=enzo
APP_DB_PASSWORD=
APP_DB_NAME=enzo
S3_ACCESS_KEY_ID=            # the replicated MinIO service user, not root
S3_SECRET_ACCESS_KEY=

# --- secrets, identical on both nodes ---
JWT_SECRET=                  # new for HA (openssl rand -base64 48)
APP_ENCRYPTION_KEY=          # prod's value, so 2FA / Gmail / Calendar tokens decrypt
REVALIDATE_SECRET=
ALERT_SHARED_SECRET=
TUNNEL_TOKEN=                # tunnel enzo-ha

# --- public URLs (ha-* hosts, https) ---
WEB_PUBLIC_URL=
ADMIN_URL=
PORTAL_URL=
API_PUBLIC_URL=
MEDIA_BASE_URL=              # https://ha-media.../enzo-public (must end in the public bucket)

# --- optional ---
ADMIN_EMAIL=                 # first admin, used only on an empty database
ADMIN_PASSWORD=
ADMIN_NAME=
ALERT_TO=
