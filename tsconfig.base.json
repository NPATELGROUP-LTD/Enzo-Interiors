{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@enzo-interiors/shared": ["packages/shared/src/index.ts"],
      "@enzo-interiors/shared/*": ["packages/shared/src/*"],
      "@enzo-interiors/ui": ["packages/ui/src/index.ts"],
      "@enzo-interiors/ui/*": ["packages/ui/src/*"]
    }
  }
}
