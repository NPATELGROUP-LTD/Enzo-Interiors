# Enzo Interiors — v1 (public site + admin CMS).
# Copy to .env and fill in. Never commit the filled-in copy.

# ---- Database --------------------------------------------------------------
# Locally PostgreSQL runs in this stack (the `db` profile below) with these.
POSTGRES_USER=enzo
POSTGRES_DB=enzo
# openssl rand -base64 24
POSTGRES_PASSWORD=
# Production: PostgreSQL runs on its own, outside this stack, so a redeploy
# never touches the data (docs/prelaunch.md). Put its URL here and leave `db`
# out of COMPOSE_PROFILES. Empty = the bundled postgres service.
DATABASE_URL=

# Which optional services run. Local: dev,db (Mailpit + PostgreSQL).
# Production: empty.
COMPOSE_PROFILES=dev,db

# ---- Auth ------------------------------------------------------------------
# At least 32 characters. The API refuses to start without it, deliberately:
# a default signing key in the repository is a key everyone has.
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# The first admin account, created by the API on its first boot while there
# are no staff accounts yet. It is never used again after that, so changing
# these later does nothing — change the password inside the admin instead.
ADMIN_EMAIL=
# At least 12 characters.  openssl rand -base64 18
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Publishing ------------------------------------------------------------
# Shared between the API and the public site. Publishing in the CMS calls the
# site's revalidate route with this, which is what makes an edit appear in
# seconds rather than at the next scheduled re-read.
# openssl rand -base64 32
REVALIDATE_SECRET=
# How long the site may serve content without re-reading, in seconds. Publishing
# does not wait for this; it is the backstop if a revalidation call is missed.
CONTENT_REVALIDATE_SECONDS=3600

# ---- Object storage (MinIO) ------------------------------------------------
# Also the MinIO root credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Marketing images: public-read, stable URLs, embedded in cached pages.
S3_PUBLIC_BUCKET=enzo-public
# Client documents: private, signed per request. Not used by v1.
S3_PRIVATE_BUCKET=enzo-private
# The browser-reachable address of the PUBLIC bucket. Not the internal
# http://minio:9000 address — a visitor cannot resolve "minio".
# Include the bucket name: https://media.enzointeriors.co.uk/enzo-public
# Upload URLs are signed for this host too, since the editor's browser PUTs
# the file there directly.
MEDIA_BASE_URL=

# ---- Public addresses ------------------------------------------------------
# Where each app is reached from a browser. The admin image is built against
# these, so changing them means rebuilding it.
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:4000

# Proxy hops in front of the API, so rate limits see the visitor's IP rather
# than the proxy's. Coolify + Cloudflare Tunnel = 2. 0 when nothing is in front.
TRUST_PROXY=0
# Search Console "HTML tag" verification code (content="..." only). Optional.
GOOGLE_SITE_VERIFICATION=

# ---- Email -----------------------------------------------------------------
# Password resets and the site's enquiry notifications. Any SMTP provider
# (Postmark, SES, Resend, a Workspace relay). With SMTP_HOST empty nothing is
# sent and the API logs a warning instead. MAIL_FROM's domain needs SPF, DKIM
# and DMARC records or the mail lands in spam (docs/prelaunch.md).
# Local dev: the dev profile starts Mailpit; then SMTP_HOST=mailpit
# SMTP_PORT=1025 and read everything at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Enzo Interiors <no-reply@enzointeriors.co.uk>

# ---- Rate limits -------------------------------------------------------------
# Counters in Redis, so limits hold across restarts. The compose file starts
# a redis service and points the API at it; set this only for an external one.
# Unset/unreachable = limits kept in the API's memory (still enforced).
# REDIS_URL=redis://redis:6379

# ---- Host ports ------------------------------------------------------------
# Offset these from the native dev ports (web 3000, admin 5174, api 4000,
# postgres 5432) if you want the docker stack and the watch-mode dev servers
# running at the same time.
WEB_PORT=3000
ADMIN_PORT=5174
# The admin SPA runs in a browser, so the API has to be reachable from the
# host, not only from inside the compose network.
API_PORT=4000
# Published so you can point psql / a GUI at the stack's database.
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
