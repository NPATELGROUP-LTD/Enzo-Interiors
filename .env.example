# Enzo Interiors — v1 (public site + admin CMS).
# Copy to .env and fill in. Never commit the filled-in copy.

# ---- Database --------------------------------------------------------------
POSTGRES_USER=enzo
POSTGRES_DB=enzo
# openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Auth ------------------------------------------------------------------
# At least 32 characters. The API refuses to start without it, deliberately:
# a default signing key in the repository is a key everyone has.
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- Publishing ------------------------------------------------------------
# Shared between the API and the public site. Publishing in the CMS calls the
# site's revalidate route with this, which is what makes an edit appear in
# seconds rather than at the next scheduled re-read.
# openssl rand -base64 32
REVALIDATE_SECRET=
# How long the site may serve content without re-reading, in seconds. Publishing
# does not wait for this; it is the backstop if a revalidation call is missed.
CONTENT_REVALIDATE_SECONDS=3600

# ---- Object storage (MinIO) ------------------------------------------------
# Also the MinIO root credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Marketing images: public-read, stable URLs, embedded in cached pages.
S3_PUBLIC_BUCKET=enzo-public
# Client documents: private, signed per request. Not used by v1.
S3_PRIVATE_BUCKET=enzo-private
# The browser-reachable address of the PUBLIC bucket. Not the internal
# http://minio:9000 address — a visitor cannot resolve "minio".
# e.g. https://media.enzointeriors.co.uk
MEDIA_BASE_URL=

# ---- Public addresses ------------------------------------------------------
# Where each app is reached from a browser. The admin image is built against
# these, so changing them means rebuilding it.
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:4000

# ---- Host ports ------------------------------------------------------------
WEB_PORT=3000
ADMIN_PORT=5174
MINIO_CONSOLE_PORT=9001
