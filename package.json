{
  "name": "enzo-interiors",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Enzo Interiors Platform — public site, admin CRM, client portal, and API",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
