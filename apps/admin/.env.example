# apps/admin — copy to .env.local.
#
# Vite inlines VITE_* at build time, so a production build is specific to the
# API host it was built against.

# Base URL of apps/api. Start the API first — the admin portal is a thin client.
VITE_API_BASE_URL=http://localhost:4000

# Public site, for the "view site" and content-preview links.
VITE_WEB_URL=http://localhost:3000
