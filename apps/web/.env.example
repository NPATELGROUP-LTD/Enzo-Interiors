# apps/web — copy to .env.local and adjust.

# Base URL of apps/api. The site reads all of its content from it, and falls
# back to the shipped copy in src/data if it is unreachable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Browser-reachable address of the public media bucket. Optional: leave unset
# and next/image simply allows no remote hosts. e.g. http://localhost:9000/enzo-public
NEXT_PUBLIC_MEDIA_BASE_URL=

# Must match apps/api's REVALIDATE_SECRET. Publishing in the CMS posts to
# /api/revalidate with it; a mismatch means edits appear only on the schedule.
REVALIDATE_SECRET=

# Seconds the site may serve content without re-reading it.
CONTENT_REVALIDATE_SECONDS=3600
