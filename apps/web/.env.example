# apps/web — copy to .env.local and adjust.

# Base URL of apps/api. The site reads all of its content from it, and falls
# back to the shipped copy in src/data if it is unreachable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# The API as the visitor's browser reaches it, for the enquiry forms. Only
# differs from the above when the server reads the API over an internal name.
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:4000

# The site's own public address: canonical URLs, share cards, the sitemap.
SITE_URL=http://localhost:3000

# Browser-reachable address of the public media bucket. Every image on the
# site, the hero frames included, is served from here.
NEXT_PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:9000/enzo-public

# Search Console "HTML tag" verification code. Optional.
GOOGLE_SITE_VERIFICATION=

# Must match apps/api's REVALIDATE_SECRET. Publishing in the CMS posts to
# /api/revalidate with it; a mismatch means edits appear only on the schedule.
REVALIDATE_SECRET=

# Seconds the site may serve content without re-reading it.
CONTENT_REVALIDATE_SECONDS=3600
