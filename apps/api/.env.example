# apps/api — Enzo Interiors backend. Copy to .env and fill in.
#
# For running the API on the host. The dockerised stack reads the .env at the
# repository root instead; see docker-compose.yml.
#
# PostgreSQL and MinIO always run in Docker, host dev included:
#   docker compose up -d --wait postgres minio minio-init

PORT=4000

# ---- Database --------------------------------------------------------------
# Required. The API will not start without it. The postgres container, with
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB from the root .env.
DATABASE_URL=postgresql://enzo:CHANGE_ME@127.0.0.1:5432/enzo?schema=public

# ---- Auth ------------------------------------------------------------------
# At least 32 characters, or the API refuses to boot — a default signing key in
# the repository is a key everyone has.  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# First admin account, created on boot only while there are no staff rows.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API (admin + web).
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# ---- Publishing ------------------------------------------------------------
# Optional. Publishing in the CMS calls the site's revalidate route with this,
# which is what makes an edit appear in seconds. Must match apps/web's
# REVALIDATE_SECRET. Unset: publishing works, the site updates on its own
# schedule instead.  openssl rand -base64 32
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# ---- Email ------------------------------------------------------------------
# Password resets + enquiry notifications. Blank SMTP_HOST = nothing is sent.
# Local: `COMPOSE_PROFILES=dev docker compose up -d mailpit`, then read mail
# at http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Enzo Interiors <no-reply@localhost>
# Where reset links point.
ADMIN_URL=http://localhost:5174
# The client portal: where portal invitations and reset links point.
PORTAL_URL=http://localhost:5175
# Rate-limit counters (`docker compose up -d redis`). Blank = in memory.
REDIS_URL=redis://127.0.0.1:6379
# Newsletter links: the website's confirm/unsubscribe pages and this API's
# one-click unsubscribe (List-Unsubscribe header).
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Proxy hops in front of the API (0 locally).
TRUST_PROXY=0
# true behind Cloudflare Tunnel (uses CF-Connecting-IP). Empty locally.
TRUST_CLOUDFLARE=

# ---- Two-step sign-in and Google -------------------------------------------
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Staff sign-in codes are emailed, so production needs SMTP_HOST set; without
# it the codes are only written to the API log.
# true = skip two-step sign-in for everyone (emergency off switch).
DISABLE_2FA=
# Google OAuth client. Empty = no Google sign-in, no calendar sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://auth.enzo.client.npatelgroup.ltd/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Production: https://auth.enzo.client.npatelgroup.ltd/calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/calendar/callback

# ---- Object storage (MinIO / S3) -------------------------------------------
# Every site image lives in the public bucket. Without these the API still
# boots, but uploads are refused.
#
# The minio container; its root credentials are S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY in the root .env.
#
# S3_PUBLIC_BASE_URL is the BROWSER-reachable address of the public bucket,
# and must spell the host the same way apps/web's NEXT_PUBLIC_MEDIA_BASE_URL
# does, or next/image rejects the optimised request.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=enzo-public
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/enzo-public
# Optional. The host upload URLs are signed for, which must be reachable from
# the editor's browser. Defaults to S3_PUBLIC_BASE_URL minus the bucket name.
# S3_PUBLIC_ENDPOINT=
