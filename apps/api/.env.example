# apps/api — Enzo Interiors backend (prototype phase)
PORT=4000
# Mock-only signing secret. NOT production-safe — see src/modules/auth/auth.service.ts.
JWT_SECRET=enzo-interiors-prototype-secret-do-not-use-in-production
JWT_EXPIRES_IN=12h
# Comma-separated origins allowed to call the API (admin + portal + web dev servers).
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:3000
