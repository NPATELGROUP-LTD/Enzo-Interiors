// Enzo Interiors — PostgreSQL schema.
//
// A 1:1 translation of docs/Enzo_Interiors_Backend_Schema_v2.0.md section 3,
// plus the CMS tables added for v1. Field names are snake_case and match the
// documented column names exactly, so src/common/types/domain.ts maps onto a
// row with no rename pass and PrismaRepository can stay generic.
//
// Money is Decimal(12,2), never float — see src/common/util/money.ts.
// Timestamps are timestamptz; PrismaRepository converts them to and from the
// ISO-8601 strings the domain types use, so no service learns about Date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* -------------------------------------------------------------------------- */
/* CRM tables (Backend Schema 3.1 - 3.18)                                     */
/* -------------------------------------------------------------------------- */

model StaffUser {
  id               String    @id
  name             String
  email            String    @unique
  password_hash    String
  role             String
  // Bumped on every password change or reset. A JWT carrying a different
  // `tv` is rejected, which is what signs every other session out.
  token_version    Int       @default(0)
  // sha256 of the emailed reset token; the token itself is never stored.
  // Also carries an invitation: an invited account has no password yet
  // (password_hash is empty) until the emailed link is used.
  reset_token_hash String?   @unique
  reset_expires_at DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  // Two-step sign-in, chosen once at the first sign-in: "email" | "totp".
  // Null = not chosen yet.
  two_factor_method String?
  // The authenticator app's secret, sealed with APP_ENCRYPTION_KEY (core/crypto.ts).
  totp_secret_enc   String?
  // Set once the first code from the app has been accepted.
  totp_confirmed_at DateTime? @db.Timestamptz(6)
  // The last 30-second step accepted, so one code cannot be used twice.
  totp_last_step    Int?
  // sha256 hex of each unused one-time recovery code.
  recovery_hashes   Json?
  // sha256 of the emailed sign-in code, its expiry and wrong guesses so far.
  login_code_hash       String?
  login_code_expires_at DateTime? @db.Timestamptz(6)
  login_code_attempts   Int       @default(0)
  // The linked Google account ("Sign in with Google"): its stable id and address.
  google_sub        String?   @unique
  google_email      String?
  project_memberships ProjectMember[]

  @@map("staff_users")
}

model Client {
  id                String   @id
  name              String
  email             String   @unique
  phone             String?
  address           String?
  status            String
  assigned_staff_id String?
  joined_date       DateTime @db.Timestamptz(6)
  total_spent       Decimal  @default(0) @db.Decimal(12, 2)
  notes             String?
  password_hash     String
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  /// Portal sessions carry it; bumping it signs every one of them out.
  token_version     Int      @default(0)
  /// True while the password is the one emailed at invite; cleared when they change or keep it.
  password_is_default Boolean @default(false)
  /// The emailed password stops working after this (7 days from the invite) while it is still the default. Null = no expiry.
  default_password_expires_at DateTime? @db.Timestamptz(6)
  /// The terms version (modules/auth/terms.ts) they last accepted; null, or an older one, = the portal asks again.
  terms_version     String?
  terms_accepted_at DateTime? @db.Timestamptz(6)

  @@index([assigned_staff_id])
  @@map("clients")
}

/// Evidence that a client accepted the portal terms: one row per acceptance, kept when the client asks again. No FK, so it outlives the client row.
model TermsAcceptance {
  id          String   @id
  client_id   String
  client_name String
  client_email String
  version     String
  ip          String?
  device      String?
  accepted_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([client_id, accepted_at])
  @@map("terms_acceptances")
}

model Project {
  id                    String   @id
  client_id             String
  name                  String
  type                  String
  status                String
  progress_pct          Int      @default(0)
  current_stage         String?
  /// Legacy single designer / installer. The team is `members` now; these mirror
  /// its first designer / installer (rollback safety) and still grant access.
  assigned_designer_id  String?
  assigned_installer_id String?
  client_visible        Boolean  @default(true)
  /// Where the work happens; null = the client's own address (invoices fall back the same way).
  site_address          String?
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)
  members               ProjectMember[]
  staff_thread          StaffThread?
  materials             ProjectMaterial[]
  stock_movements       StockMovement[]

  @@index([client_id])
  @@index([assigned_designer_id])
  @@index([assigned_installer_id])
  /// Shown as PRJ-0001 / ENQ-0001: a readable number for searching and for quoting on the phone.
  ref_no               Int      @default(autoincrement()) @unique
  @@map("projects")
}

/// Who works on a project: any number of designers and installers. Being a row
/// here grants the project (AccessService.projectScope). Carries no money and no
/// dates, so it is safe to list to any member; an installer's terms are in
/// `installer_assignments`.
model ProjectMember {
  id         String    @id
  project_id String
  staff_id   String
  /// "Designer" | "Installer"
  role       String
  added_by   String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  project    Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  staff      StaffUser @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  assignment InstallerAssignment?

  @@unique([project_id, staff_id, role])
  @@index([staff_id])
  @@map("project_members")
}

/// An installer's dates and pay on one project: only the Admin and that installer
/// ever see this row (modules/projects/team.service.ts). Nothing in it may reach
/// a list, a search, the activity log or another member's view.
model InstallerAssignment {
  id                 String        @id
  member_id          String        @unique
  /// Calendar days, no time zone.
  start_date         DateTime?     @db.Date
  end_date           DateTime?     @db.Date
  /// Null until the Admin sends it; the installer sees none of this before.
  sent_at            DateTime?     @db.Timestamptz(6)
  pay                Decimal?      @db.Decimal(12, 2)
  pay_note           String?
  /// "pending" | "approved" | "declined"
  pay_status         String        @default("pending")
  /// "pending" | "approved"; the installer suggests other dates instead of declining.
  dates_status       String        @default("pending")
  suggested_start    DateTime?     @db.Date
  suggested_end      DateTime?     @db.Date
  suggestion_comment String?
  suggested_at       DateTime?     @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @db.Timestamptz(6)
  member             ProjectMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@map("installer_assignments")
}

model ComponentItem {
  id          String   @id
  name        String
  category    String
  unit_price  Decimal  @db.Decimal(12, 2)
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("components")
}

model Quote {
  id         String   @id
  client_id  String
  service_id String
  type       String
  design_fee Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  vat_rate   Decimal  @db.Decimal(5, 2)
  total      Decimal  @db.Decimal(12, 2)
  status     String
  invoice_id String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([client_id])
  @@map("quotes")
}

// unit_price here is a POINT-IN-TIME SNAPSHOT of ComponentItem.unit_price.
// Changing a component price must never rewrite this column. See
// quotes.service.ts and Backend Schema section 6.
model QuoteLineItem {
  id             String  @id
  quote_id       String
  component_id   String
  component_name String
  quantity       Int
  unit_price     Decimal @db.Decimal(12, 2)
  line_total     Decimal @db.Decimal(12, 2)

  @@index([quote_id])
  @@map("quote_line_items")
}

model Invoice {
  id         String    @id
  number     String    @unique
  client_id  String
  project_id String?
  quote_id   String?
  amount     Decimal   @db.Decimal(12, 2)
  vat_rate   Decimal   @db.Decimal(5, 2)
  status     String
  due_date   DateTime  @db.Timestamptz(6)
  paid_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  /// Fixed £ off the lines' subtotal, taken before VAT (modules/invoices/totals.ts).
  discount         Decimal @default(0) @db.Decimal(12, 2)
  job_name         String?
  job_address      String?
  job_notes        String?
  /// [{label, amount, date}]: deposit received, due on delivery... Display only, never summed into amount.
  payment_schedule Json    @default("[]")
  /// The portal only lets a client view an invoice unless an Admin allows download and print.
  client_can_download Boolean @default(false)
  items      InvoiceItem[]
  stages     InvoiceStage[]

  @@index([client_id])
  @@map("invoices")
}

/// Line items of an invoice: net (ex-VAT) prices; invoices.amount is derived from them.
model InvoiceItem {
  id          String   @id
  invoice_id  String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unit_price  Decimal  @db.Decimal(12, 2)
  /// The heading this line sits under ("Materials", "Add ons"); null = none.
  section     String?
  /// Second column of the printed invoice, e.g. "Replaced with quartz".
  detail      String?
  position    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  invoice     Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@map("invoice_items")
}

/// A payment stage of an invoice ("On start" 50%, "On installation" 40%...). `amount` is worked out
/// from mode + value against invoices.amount (modules/invoices/stages.ts); the invoice is Paid only
/// when every stage has paid_at. No stages = the invoice is paid in one go, as before.
model InvoiceStage {
  id         String    @id
  invoice_id String
  position   Int       @default(0)
  /// The trigger: "On start", "On installation", "On completion".
  label      String
  /// "percent" (of the gross payable) | "fixed" (a £ amount).
  mode       String
  value      Decimal   @db.Decimal(12, 2)
  amount     Decimal   @db.Decimal(12, 2)
  due_note   String?
  paid_at    DateTime? @db.Timestamptz(6)
  /// Name of the Admin who recorded it; never sent to clients.
  paid_by    String?
  invoice    Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@unique([invoice_id, position])
  @@map("invoice_stages")
}

/// A quote written by hand for a project and sent to its client. Lines are net prices, like an invoice's;
/// amount is the gross (computed in modules/invoices/totals.ts). An accepted one becomes a Draft invoice (invoice_id).
model ProjectQuote {
  id               String             @id
  number           String             @unique
  client_id        String
  project_id       String
  title            String?
  /// Draft | Sent | Accepted | Declined
  status           String             @default("Draft")
  amount           Decimal            @db.Decimal(12, 2)
  vat_rate         Decimal            @db.Decimal(5, 2)
  /// Fixed £ off the subtotal, before VAT.
  discount         Decimal            @default(0) @db.Decimal(12, 2)
  valid_until      DateTime?          @db.Timestamptz(6)
  notes            String?
  sent_at          DateTime?          @db.Timestamptz(6)
  responded_at     DateTime?          @db.Timestamptz(6)
  response_comment String?
  invoice_id       String?
  created_by       String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  items            ProjectQuoteItem[]
  /// The quote maker design it was made from; the design's deletion leaves the quote.
  design_id        String?
  design           QuoteDesign?       @relation(fields: [design_id], references: [id], onDelete: SetNull)

  @@index([client_id])
  @@index([project_id])
  @@index([design_id])
  @@map("project_quotes")
}

model ProjectQuoteItem {
  id          String       @id
  quote_id    String
  description String
  section     String?
  detail      String?
  quantity    Decimal      @db.Decimal(10, 2)
  unit_price  Decimal      @db.Decimal(12, 2)
  cost_price  Decimal?     @db.Decimal(12, 2)
  margin_pct  Decimal?     @db.Decimal(6, 2)
  position    Int          @default(0)
  quote       ProjectQuote @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([quote_id])
  @@map("project_quote_items")
}

model Booking {
  id              String   @id
  client_id       String
  service_type    String
  date_time       DateTime @db.Timestamptz(6)
  status          String
  linked_quote_id String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([client_id])
  @@index([date_time])
  @@map("bookings")
}

model AvailabilitySetting {
  id                 String  @id
  day_of_week        Int
  start_time         String
  end_time           String
  slot_duration_mins Int
  is_closed          Boolean @default(false)

  @@map("availability_settings")
}

model Conversation {
  id         String   @id
  client_id  String
  subject    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([client_id])
  @@unique([client_id]) // one conversation per client (migration 11)
  @@map("conversations")
}

model Message {
  id              String    @id
  conversation_id String
  sender_id       String
  sender_type     String
  body            String
  attachments     Json?
  read_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([conversation_id])
  @@map("messages")
}

model SavedReplyTemplate {
  id       String  @id
  staff_id String?
  title    String
  body     String

  @@map("saved_reply_templates")
}

model NotificationPreference {
  id             String  @id
  owner_id       String
  owner_type     String
  email_enabled  Boolean @default(true)
  sms_enabled    Boolean @default(false)
  in_app_enabled Boolean @default(true)
  /// { project|invoice|document|message: { in_app, email, push } }; null = defaults.
  categories     Json?

  @@map("notification_preferences")
}

model DocumentRecord {
  id             String   @id
  client_id      String
  project_id     String?
  name           String
  type           String
  size_bytes     Int
  upload_date    DateTime @db.Timestamptz(6)
  client_visible Boolean  @default(false)
  /// Settings › Document categories label; null = `type`. Free text so removing a category loses nothing.
  category       String?
  /// The portal only lets a client view a file unless an Admin allows saving it.
  client_can_download Boolean @default(false)
  // S3 object KEY only. Never a full or signed URL — those are built at
  // request time by the storage service. See CLAUDE.md Critical Do's.
  storage_url    String

  @@index([client_id])
  @@map("documents")
}

model Testimonial {
  id           String   @id
  client_name  String
  rating       Int
  review_text  String
  project_id   String?
  is_published Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("testimonials")
}

model PortfolioItem {
  id             String  @id
  project_id     String?
  title          String
  category       String
  location       String?
  year           Int?
  duration_weeks Int?
  description    String?
  materials_used String?
  image_urls     Json
  is_published   Boolean @default(false)

  @@map("portfolio_items")
}

model ContactSubmission {
  id               String   @id
  name             String
  email            String
  phone            String?
  service_interest String?
  message          String
  status           String
  // "contact" | "quote" | "booking": which form on the site sent it.
  kind             String   @default("contact")
  // The form's extra fields (tier, room, preferred date...), flat strings.
  details          Json?
  // Where it came from, shown as a tag: "Contact" | "Booking" | "Quote". Null on rows from before it existed.
  source           String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  messages         EnquiryMessage[]
  designs          QuoteDesign[]

  @@index([status])
  /// Shown as PRJ-0001 / ENQ-0001: a readable number for searching and for quoting on the phone.
  ref_no               Int      @default(autoincrement()) @unique
  @@map("contact_submissions")
}

// What an Admin sent an enquirer from the inbox (modules/enquiries), oldest first.
// direction is "out" for now; "in" is for replies read from the mailbox later.
model EnquiryMessage {
  id         String            @id
  enquiry_id String
  direction  String
  body       String
  to_address String
  sent_by    String?
  sent_at    DateTime          @default(now()) @db.Timestamptz(6)
  enquiry    ContactSubmission @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)

  @@index([enquiry_id, sent_at])
  @@map("enquiry_messages")
}

model BusinessSettings {
  id                  String  @id
  business_name       String
  vat_rate            Decimal @db.Decimal(5, 2)
  logo_url            String?
  brand_primary_color String
  email_from_address  String?

  @@map("business_settings")
}

model ActivityLog {
  id           String   @id
  staff_id     String
  actor_type   String
  actor_name   String
  action       String
  target_table String
  target_id    String
  details      Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@map("activity_logs")
}

/* -------------------------------------------------------------------------- */
/* CMS                                                                        */
/* -------------------------------------------------------------------------- */

// Every editable thing on the public site is one row here: a service, a
// portfolio project, a testimonial, a team member, an FAQ, a nav link, and
// each page copy tree.
//
// One table rather than eight because every one of them needs the same four
// things — draft, published, ordering, audit — and nothing else needs to JOIN
// on their innards. The field-level shape is described by the descriptors in
// src/modules/cms/schemas.ts, which the admin fetches to render its forms, so
// each shape is declared exactly once and drives both validation and UI.
//
// ponytail: content bodies are JSONB validated in the app layer, not columns
// with constraints. Promote a field to a real column when something needs to
// query or report on it, not before.
model CmsEntry {
  id           String    @id
  // "pages" | "services" | "portfolio" | "testimonials" | "team" | "faqs"
  // | "navigation" | "company"
  collection   String
  // Unique within the collection. For services this is also the route slug
  // (/services/[category]); for pages it is the page key ("home", "legal").
  slug         String
  sort_order   Int       @default(0)
  // The editable copy. Always present — this is what the admin loads.
  draft        Json
  // The live copy. Null until first publish, which is how "never published"
  // is told apart from "published, then edited".
  published    Json?
  published_at DateTime? @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_by   String?
  // An editor's "send for review": who asked (staff_users.id), when, and the
  // note they left. Cleared when an admin publishes or sends it back.
  review_by    String?
  review_at    DateTime? @db.Timestamptz(6)
  review_note  String?
  // The Admin's note from the last send-back, shown to the editor until they
  // send again or it is published.
  review_feedback String?

  @@unique([collection, slug])
  @@index([collection, sort_order])
  @@map("cms_entries")
}

// Every site image. The row holds the object KEY in the public bucket; the URL
// is built from S3_PUBLIC_BASE_URL at read time. `source` is where the file
// came from: "upload", "site", or "unsplash"/"randomuser" for placeholders
// still waiting to be replaced (docs/prelaunch.md).
model MediaAsset {
  id          String   @id
  storage_key String
  alt         String
  title       String?
  source      String
  width       Int?
  height      Int?
  byte_size   Int?
  mime_type   String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  inventory_items InventoryItem[]

  @@map("media_assets")
}

// General site settings. A single row, id "site".
model SiteSettings {
  id                  String    @id
  // "live" | "coming_soon"
  status              String    @default("coming_soon")
  // Once set and passed, the site is live whatever `status` says.
  launch_at           DateTime? @db.Timestamptz(6)
  // Who receives enquiry notifications. Empty falls back to ADMIN_EMAIL.
  notification_emails String[]  @default([])
  // Brand: media ids. The logos replace company.logos on the site; a null
  // favicon means the site's own /icon.png.
  logo_light_id       String?   @default("logo-forest")
  logo_dark_id        String?   @default("logo-white")
  favicon_id          String?
  // Shown in browsers set to dark mode; null = favicon_id for both.
  favicon_dark_id     String?
  // The studio's opening hours: { weekly, notes, note }. Null until first
  // saved in Settings, and until then the company record's hours are used.
  opening_hours       Json?
  // Settings › Pages: { about: true, ... }. Null or a missing key = the
  // default in modules/site-settings/pages.ts, computed on read.
  pages               Json?
  // Settings › Project stages: [{ name, progress, approval }], in order. Null =
  // the default five in modules/projects/stages.ts, computed on read.
  project_stages      Json?
  // Settings › Document categories: ["Contract", ...]. Null = the five
  // document types, computed on read (modules/documents).
  document_categories Json?
  // Settings › Bank details: { account_name, bank_name, sort_code, account_number,
  // reference_note }, printed on invoices. Null = none yet. Never in the public bundle.
  bank_details        Json?
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_by          String?

  @@map("site_settings")
}

/* -------------------------------------------------------------------------- */
/* Consultation bookings                                                      */
/* -------------------------------------------------------------------------- */

// The schedule and the booking form's rules. A single row, id "booking".
// ponytail: one JSONB body validated by the DTO, so a new rule is a code
// change and never a migration. Promote a field to a column if SQL needs it.
model BookingSettings {
  id         String   @id
  config     Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  updated_by String?

  @@map("booking_settings")
}

// A home consultation, booked on the website or by staff. Separate from the
// CRM's `bookings`, which belongs to a client record the website never has.
model Appointment {
  id            String    @id
  // Short code quoted in emails ("EZ-7K3Q9P").
  reference     String    @unique
  // services.slug at booking time, and its name, kept in case it is renamed.
  service       String
  service_label String
  starts_at     DateTime  @db.Timestamptz(6)
  ends_at       DateTime  @db.Timestamptz(6)
  // starts_at as ISO while the booking holds its slot, null once cancelled.
  // Unique, so the database itself refuses a second booking at the same time
  // however close together two visitors click.
  slot          String?   @unique
  // "Confirmed" | "Cancelled"
  status        String    @default("Confirmed")
  name          String
  email         String
  phone         String?
  address       String?
  postcode      String?
  notes         String?
  // Anything else the form carried (the quote tier).
  details       Json?
  // "website" | "admin"
  source        String
  created_by    String?
  cancelled_at  DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  // The Google Calendar event mirroring this booking, and the calendar it is
  // in. Null = not synced (no calendar connected, or the sync failed).
  google_event_id        String?
  calendar_connection_id String?
  // Which of the connection's calendars the event is in, so a calendar change
  // can still find (and move) events made before it.
  google_calendar_id     String?

  @@index([starts_at])
  @@map("appointments")
}

// The admin's bell: one row per recipient.
model Notification {
  id           String    @id
  recipient_id String
  // "booking" | "review" | "review_reply" | "project" | "message" | "invoice" | "document" | "enquiry"
  kind         String
  title        String
  body         String?
  // An admin path to open, e.g. /bookings?open=<id>.
  link         String?
  read_at      DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([recipient_id, created_at])
  // The bell's unread count, polled every minute by every open admin.
  @@index([recipient_id, read_at])
  @@map("notifications")
}

// A browser's Web Push subscription (admin or portal PWA), one per device.
// Sent to wherever a bell notification is created (modules/notifications).
model PushSubscription {
  id         String   @id
  owner_id   String
  // "staff" | "client": ids come from different tables, so every read names both.
  owner_type String
  // The push service URL. Unique: a re-subscribe from the same browser moves it.
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_type, owner_id, created_at])
  @@map("push_subscriptions")
}

/* -------------------------------------------------------------------------- */
/* Newsletter                                                                 */
/* -------------------------------------------------------------------------- */

// Someone who asked for the newsletter. Double opt-in: "pending" until they
// click the link in the confirmation email; only "confirmed" rows are sent to.
model NewsletterSubscriber {
  id              String    @id
  // Lower-cased and trimmed, so one address is one row.
  email           String    @unique
  // "pending" | "confirmed" | "unsubscribed"
  status          String    @default("pending")
  // In the confirm and unsubscribe links. Random, never reused.
  token           String    @unique
  // Where they signed up: "coming_soon" | "footer".
  source          String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  // The last confirmation email, so a form cannot be used to mail-bomb someone.
  confirm_sent_at DateTime? @db.Timestamptz(6)
  confirmed_at    DateTime? @db.Timestamptz(6)
  unsubscribed_at DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  // Sending pages through confirmed subscribers in id order.
  @@index([status, id])
  @@map("newsletter_subscribers")
}

// One newsletter: its HTML body, and how far sending got.
model NewsletterCampaign {
  id           String    @id
  subject      String
  // The body as the admin wrote it, already sanitised; wrapped in the branded
  // shell (logo, address, unsubscribe link) when sent.
  html         String
  // "draft" | "sending" | "sent"
  status       String    @default("draft")
  recipients   Int       @default(0)
  sent_count   Int       @default(0)
  failed_count Int       @default(0)
  // The last subscriber id handled, so a restart carries on rather than
  // starting again.
  cursor       String?
  created_by   String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  sent_at      DateTime? @db.Timestamptz(6)

  @@index([created_at])
  @@map("newsletter_campaigns")
}

/* -------------------------------------------------------------------------- */
/* Two-step sign-in and Google Calendar                                       */
/* -------------------------------------------------------------------------- */

// A browser that ticked "remember this device": two-step sign-in is skipped
// there until expires_at. The token lives in the browser; only its sha256 here.
model TrustedDevice {
  id            String   @id
  staff_user_id String
  token_hash    String   @unique
  // A short summary of the user agent, for the account page ("Chrome on Windows").
  label         String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  last_used_at  DateTime @default(now()) @db.Timestamptz(6)
  expires_at    DateTime @db.Timestamptz(6)

  @@index([staff_user_id])
  @@map("trusted_devices")
}

// A Google Calendar bookings are copied into. v1 has one, the studio's, with
// the fixed id "studio"; staff_user_id leaves room for per-staff calendars.
model CalendarConnection {
  id                String   @id
  // Null = the studio calendar.
  staff_user_id     String?
  google_email      String
  calendar_id       String   @default("primary")
  calendar_name     String?
  // Google's refresh token, sealed with APP_ENCRYPTION_KEY (core/crypto.ts).
  refresh_token_enc String
  // "connected" | "needs_reconnect" (Google refused the token).
  status            String   @default("connected")
  connected_by      String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("calendar_connections")
}

// One staff member's own Gmail (Google Workspace), linked from the Mail page
// (modules/mailbox). Only the sealed refresh token is kept, never any mail.
model GmailAccount {
  id                String   @id
  staff_id          String   @unique
  google_email      String
  // Sealed with APP_ENCRYPTION_KEY (core/crypto.ts).
  refresh_token_enc String
  // Space-separated scopes Google granted.
  scopes            String
  connected_at      DateTime @default(now()) @db.Timestamptz(6)
  // Google refused the token (revoked, password changed): reconnect to use Mail again.
  needs_reconnect   Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("gmail_accounts")
}

// A Designer's client edit or an Installer's stage move, waiting for an Admin
// (modules/change-requests). Approving replays it as the Admin.
// An Admin asks an Infra manager to remove another Admin (modules/auth/users).
// target_* are copied so the request still reads after the person is gone.
model StaffRemovalRequest {
  id             String    @id
  target_id      String
  target_name    String
  target_email   String
  requested_by   String
  requested_name String
  reason         String
  // "Pending" | "Approved" | "Declined"
  status         String    @default("Pending")
  decided_by     String?
  decided_name   String?
  decision_note  String?
  decided_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at])
  @@index([target_id])
  @@map("staff_removal_requests")
}

model ChangeRequest {
  id             String    @id
  // "client_details" | "project_stage"
  kind           String
  client_id      String
  project_id     String?
  requested_by   String
  requested_name String
  // client_details: { phone?, address?, notes? }; project_stage: { status }
  payload        Json
  note           String?
  // "Pending" | "Approved" | "Declined"
  status         String    @default("Pending")
  decided_by     String?
  decided_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at])
  @@index([client_id])
  @@map("change_requests")
}

// Who receives the alert emails, and whether error alerts are on. One row,
// id "alerts" (modules/alerts). Empty recipients fall back to ALERT_TO.
model AlertSettings {
  id         String   @id
  recipients String[] @default([])
  errors_on  Boolean  @default(true)
  // The 08:00 summary, and the London day (YYYY-MM-DD) it last went out on
  digest_on  Boolean  @default(true)
  digest_day String?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  updated_by String?

  @@map("alert_settings")
}

// One row per kind of problem, keyed by a fingerprint of what happened and
// where. `count` is how often it has happened; rows older than 30 days go.
// Holds the route and the first line of the error, never a body or a person.
model AlertEvent {
  id       String   @id
  // "urgent" | "error" | "security"
  kind     String
  // "api" | "web" | "admin" | "portal" | "system"
  source   String
  title    String
  route    String?
  location String?
  status   Int?
  release  String?
  count    Int      @default(1)
  first_at DateTime @default(now()) @db.Timestamptz(6)
  last_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([last_at])
  @@map("alert_events")
}

// Who touched the platform, from where: a sign-in (good) or a request worth
// remembering (a change, a refusal, a download). `route` is a pattern
// (/projects/:id), never a URL with its query, and nothing from a body is
// kept. The IP, country and device go with the row, and the row goes after
// 90 days (core/access-log.service.ts). Read by the Infra manager only.
model AccessEvent {
  id         String   @id
  at         DateTime @default(now()) @db.Timestamptz(6)
  // "signin" | "request"
  kind       String
  actor_id   String?
  // "Staff" | "Client"; null = not signed in
  actor_kind String?
  // A name, or for a failed sign-in the masked address that was typed
  actor_name String?
  actor_role String?
  method     String
  route      String
  target_id  String?
  status     Int
  ip         String?
  country    String?
  device     String?

  @@index([at])
  @@index([actor_id, kind])
  @@map("access_events")
}

/// Staff-only chat: one thread per project (project_id) or one per pair of staff (pair_key = the two ids, sorted, joined by ":").
model StaffThread {
  id         String         @id
  project_id String?        @unique
  pair_key   String?        @unique
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  project    Project?       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  messages   StaffMessage[]

  @@map("staff_threads")
}

model StaffMessage {
  id          String      @id
  thread_id   String
  /// A staff_users.id, kept when that person is later removed.
  sender_id   String
  body        String
  /// [{ key, name, size_bytes, type }] in the private bucket.
  attachments Json?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  thread      StaffThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@index([thread_id, created_at])
  @@map("staff_messages")
}

/// When a staff member last opened a thread: everything newer from someone else is unread.
model StaffThreadRead {
  id        String   @id
  thread_id String
  staff_id  String
  read_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([thread_id, staff_id])
  @@map("staff_thread_reads")
}

// Inventory (modules/inventory, migration 34). The ledger is the truth; on_hand and avg_cost are kept in step with it.
model InventorySupplier {
  id           String          @id
  name         String
  contact_name String?
  email        String?
  phone        String?
  lead_days    Int?
  notes        String?
  created_at   DateTime        @default(now()) @db.Timestamptz(6)
  updated_at   DateTime        @default(now()) @db.Timestamptz(6)
  items        InventoryItem[]
  orders       PurchaseOrder[]

  @@map("inventory_suppliers")
}

model InventoryItem {
  id            String             @id
  sku           String             @unique
  name          String
  /// Sheet | Hardware | Bought-in
  type          String
  category      String?
  unit          String             @default("each")
  size_note     String?
  supplier_id   String?
  /// Whole units; a CHECK in the migration keeps it >= 0.
  on_hand       Int                @default(0)
  /// Weighted average net cost per unit.
  avg_cost      Decimal            @default(0) @db.Decimal(12, 2)
  reorder_level Int?
  low_notified  Boolean            @default(false)
  active        Boolean            @default(true)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @db.Timestamptz(6)
  // Specs (migration 37): the one material record the quote maker shares. Editors edit these
  // (and the image) only; cost, stock and supplier stay the Admin's.
  length_mm     Int?
  width_mm      Int?
  thickness_mm  Int?
  /// The grain runs along length_mm, so panels cut from it may not rotate.
  grain         Boolean            @default(false)
  /// carcass | front | worktop | back; null for anything that is not a board.
  board_role    String?
  /// #rrggbb, lower case.
  swatch        String?
  image_id      String?
  /// [{ label, value }], shown as a spec list.
  specs         Json               @default("[]")
  /// Offered as a finish on the public quote maker (with public_name, else name).
  show_on_site  Boolean            @default(false)
  public_name   String?
  /// What the quote maker prices this at; null = avg_cost. Admin only, never sent to the public.
  quote_cost    Decimal?           @db.Decimal(12, 2)
  image         MediaAsset?        @relation(fields: [image_id], references: [id], onDelete: SetNull)
  supplier      InventorySupplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  movements     StockMovement[]
  materials     ProjectMaterial[]
  order_lines   PurchaseOrderItem[]

  @@index([supplier_id])
  @@index([image_id])
  @@map("inventory_items")
}

/// Append-only: never updated or deleted.
model StockMovement {
  id         String        @id
  item_id    String
  /// receive | issue | return | adjust
  kind       String
  /// Signed: + into stock, - out of it.
  quantity   Int
  unit_cost  Decimal       @db.Decimal(12, 2)
  reason     String?
  by_id      String?
  by_name    String
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  project_id String?
  /// A receipt booked against a purchase order (migration 36).
  po_id      String?
  item       InventoryItem  @relation(fields: [item_id], references: [id], onDelete: Restrict)
  project    Project?       @relation(fields: [project_id], references: [id], onDelete: SetNull)
  order      PurchaseOrder? @relation(fields: [po_id], references: [id], onDelete: SetNull)

  @@index([item_id, created_at])
  @@index([project_id])
  @@index([po_id])
  @@map("stock_movements")
}

/// What a project needs, holds (reserved) and has used (issued) of one item. Available stock is
/// on_hand minus every line's reserved, computed, never stored.
model ProjectMaterial {
  id         String        @id
  project_id String
  item_id    String
  needed     Int           @default(0)
  reserved   Int           @default(0)
  issued     Int           @default(0)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @db.Timestamptz(6)
  project    Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [item_id], references: [id], onDelete: Restrict)

  @@unique([project_id, item_id])
  @@index([item_id])
  @@map("project_materials")
}

/// One row, id 'inventory'.
model InventorySetting {
  id               String   @id
  /// Entering this project stage reserves what each line still needs. Null = by hand only.
  reserve_on_stage String?
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  @@map("inventory_settings")
}

/// A purchase order to a supplier (migration 36). Draft -> Sent -> Part-received -> Received, or Cancelled
/// before anything arrives. Line costs are net; VAT and gross come from invoices/totals.ts.
model PurchaseOrder {
  id          String              @id
  ref_no      Int                 @unique @default(autoincrement())
  supplier_id String
  /// Draft | Sent | Part-received | Received | Cancelled
  status      String              @default("Draft")
  vat_rate    Decimal             @default(20) @db.Decimal(5, 2)
  expected_at DateTime?           @db.Timestamptz(6)
  notes       String?
  sent_at     DateTime?           @db.Timestamptz(6)
  created_by  String?
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime            @default(now()) @db.Timestamptz(6)
  supplier    InventorySupplier   @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  movements   StockMovement[]

  @@index([supplier_id])
  @@index([status])
  @@map("purchase_orders")
}

/// Whole units ordered; received never passes it (CHECK in the migration).
model PurchaseOrderItem {
  id        String        @id
  po_id     String
  item_id   String
  quantity  Int
  received  Int           @default(0)
  unit_cost Decimal       @db.Decimal(12, 2)
  position  Int           @default(0)
  order     PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [item_id], references: [id], onDelete: Restrict)

  @@index([po_id])
  @@index([item_id])
  @@map("purchase_order_items")
}

/* -------------------------------------------------------------------------- */
/* Quote maker (migration 38)                                                 */
/* -------------------------------------------------------------------------- */

/// The unit library. slots / variants / hardware are JSONB (shapes in data/quote-maker-store.ts);
/// the inventory item ids inside are checked by the API on save and again when pricing.
model UnitTemplate {
  id           String   @id
  slug         String   @unique
  name         String
  description  String?
  /// ROOM_TYPES ids in modules/quote-maker/engine.ts
  room_types   String[] @default([])
  /// floor | wall | tall | gap (an unpriced appliance space)
  mount        String
  /// Height of the underside above the floor, for wall units.
  elevation_mm Int      @default(0)
  /// { doors, drawers, shelves, back, plinth_mm, worktop }: drawn in 3D, and the panel recipe.
  structure    Json
  slots        Json     @default("[]")
  variants     Json     @default("[]")
  hardware     Json     @default("[]")
  /// Fitting time per unit, priced at the pricing settings' hourly rate.
  labour_hours Decimal  @default(0) @db.Decimal(6, 2)
  /// Optional fixed £ per unit on top (LED, fire install, ...).
  labour_extra Decimal  @default(0) @db.Decimal(12, 2)
  active       Boolean  @default(true)
  position     Int      @default(0)
  /// 'starter library' = as shipped and never edited, so the import may still update it.
  updated_by   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("unit_templates")
}

/// One row, id 'quote_maker': margin, range, saw allowances, hourly rate, default board per role.
model QuoteMakerSetting {
  id         String   @id
  pricing    Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  updated_by String?

  @@map("quote_maker_settings")
}

/// A quote maker design (walls and the units on them), from the website (with its enquiry) or made by staff. Shown as QD-0007.
model QuoteDesign {
  id            String             @id
  ref_no        Int                @unique @default(autoincrement())
  /// web | staff
  source        String
  title         String?
  room_type     String
  design        Json
  /// The questions' answers, when it was filled from them.
  answers       Json?
  /// The range last priced, VAT included; null when it could not be priced.
  estimate_low  Decimal?           @db.Decimal(12, 2)
  estimate_high Decimal?           @db.Decimal(12, 2)
  enquiry_id    String?
  enquiry       ContactSubmission? @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  created_by    String?
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @db.Timestamptz(6)
  quotes        ProjectQuote[]

  @@index([enquiry_id])
  @@index([created_at])
  @@map("quote_designs")
}
